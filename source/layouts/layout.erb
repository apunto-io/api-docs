<%#
Layout of the Apunto API docs (Middleman + Slate rendering).
Sidebar groups come from the `navigation` frontmatter (lib/nav_data.rb).
%>
<% language_tabs = current_page.data.language_tabs || [] %>
<% page_content = yield %>
<%
  if current_page.data.includes
    current_page.data.includes.each do |include|
      page_content += partial("includes/#{include}")
    end
  end
%>
<% nav = nav_data(page_content, current_page.data.navigation) %>
<% lang_items = language_tabs.map { |lang| lang.is_a?(Hash) ? [lang.keys.first, lang.values.first] : [lang, lang] } %>

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <script>
      (function () {
        var key = 'apunto-docs-theme';
        var stored = null;
        try { stored = localStorage.getItem(key); } catch (e) {}
        var theme = stored === 'dark' || stored === 'light'
          ? stored
          : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <% if current_page.data.key?('meta') %>
      <% current_page.data.meta.each do |meta| %>
        <meta <% meta.each do |key, value| %><%= "#{key}=\"#{value}\"" %> <% end %>>
      <% end %>
    <% end %>
    <title><%= current_page.data.title || "Apunto API" %></title>
    <link rel="icon" href="images/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style media="screen">
      <%= Rouge::Themes::ApuntoCode.render(scope: '.highlight') %>
    </style>
    <style media="print">
      * { transition: none !important; }
      <%= Rouge::Themes::Base16::Solarized.render(scope: '.highlight') %>
    </style>
    <%= stylesheet_link_tag :screen, media: :screen %>
    <%= stylesheet_link_tag :print, media: :print %>
    <% if current_page.data.search %>
      <%= javascript_include_tag "all" %>
    <% else %>
      <%= javascript_include_tag "all_nosearch" %>
    <% end %>
  </head>

  <body class="<%= page_classes %>" data-languages="<%=h lang_items.map(&:first).to_json %>">
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <header class="topbar">
      <div class="topbar-left">
        <button type="button" class="icon-button nav-toggle" id="nav-toggle" aria-label="Abrir navegación" aria-controls="sidebar" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <a href="#introduccion" class="brand">
          <%= image_tag "logo.png", class: 'brand-logo', alt: 'Apunto' %>
          <span class="brand-divider" aria-hidden="true"></span>
          <span class="brand-product">API</span>
          <span class="brand-version">v1</span>
        </a>
      </div>

      <% if current_page.data.search %>
        <div class="search" role="search">
          <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" class="search-input" id="input-search" placeholder="Buscar en la documentación" autocomplete="off" aria-label="Buscar en la documentación">
          <button type="button" id="search-clear" class="search-clear" aria-label="Limpiar búsqueda">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
          <kbd class="search-kbd" aria-hidden="true">/</kbd>
          <ul class="search-results" role="listbox"></ul>
        </div>
      <% end %>

      <div class="topbar-right">
        <nav class="topbar-links" aria-label="Enlaces">
          <a href="#historial-de-cambios">Cambios</a>
          <a href="https://control.apunto.io" target="_blank" rel="noopener">Plataforma <span aria-hidden="true">↗</span></a>
        </nav>
        <button type="button" class="icon-button theme-toggle" id="theme-toggle" aria-label="Cambiar entre tema claro y oscuro" title="Tema claro / oscuro">
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </header>

    <nav class="sidebar" id="sidebar" aria-label="Documentación">
      <div class="sidebar-inner" id="toc">
        <% nav.each do |group| %>
          <div class="nav-group">
            <div class="nav-group-title"><%= group[:title] %></div>
            <ul class="nav-list">
              <% group[:sections].each do |section| %>
                <li class="nav-item" data-section="<%= section[:id] %>">
                  <a href="#<%= section[:id] %>" class="nav-link toc-link<%= ' has-children' if section[:children].any? %>" data-target="<%= section[:id] %>"><%= section[:title] %></a>
                  <% if section[:children].any? %>
                    <ul class="nav-sublist">
                      <% section[:children].each do |child| %>
                        <li>
                          <a href="#<%= child[:id] %>" class="nav-sublink toc-link" data-target="<%= child[:id] %>">
                            <span class="nav-sublink-title"><%= child[:title] %></span>
                            <% if child[:method] %><span class="method method-<%= child[:method].downcase %>"><%= child[:method] == 'DELETE' ? 'DEL' : child[:method] %></span><% end %>
                          </a>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="sidebar-footer">
          <a href="llms-full.txt">Referencia en Markdown (LLMs)</a>
        </div>
      </div>
    </nav>
    <div class="nav-overlay" id="nav-overlay" hidden></div>

    <div class="page-wrapper">
      <div class="dark-box">
        <% if lang_items.any? %>
          <div class="lang-bar" role="tablist" aria-label="Lenguaje de los ejemplos">
            <% lang_items.each do |key, label| %>
              <button type="button" class="lang-chip" role="tab" data-language-name="<%= key %>">
                <%= image_tag "lang/#{lang_icon_asset(key)}.svg", alt: '', class: 'lang-chip-icon' %>
                <span><%= label %></span>
              </button>
            <% end %>
          </div>
        <% end %>
      </div>

      <main class="content" id="main">
        <% if lang_items.any? %>
          <div class="lang-bar lang-bar-inline" role="tablist" aria-label="Lenguaje de los ejemplos">
            <% lang_items.each do |key, label| %>
              <button type="button" class="lang-chip" role="tab" data-language-name="<%= key %>"><span><%= label %></span></button>
            <% end %>
          </div>
        <% end %>

        <%= page_content %>

        <footer class="page-footer">
          <p>Apunto API v1 · <a href="#historial-de-cambios">Historial de cambios</a> · <a href="llms-full.txt">Markdown completo</a> · <a href="https://control.apunto.io" target="_blank" rel="noopener">Ir a la plataforma</a></p>
        </footer>
      </main>
    </div>
  </body>
</html>
