<% language_tabs = current_page.data.language_tabs || [] %>
<% page_content = yield %>
<%
  if current_page.data.includes
    current_page.data.includes.each do |include|
      page_content += partial("includes/#{include}")
    end
  end
%>

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <script>
      (function () {
        var key = 'apunto-docs-theme';
        var stored = localStorage.getItem(key);
        var theme = stored === 'dark' || stored === 'light'
          ? stored
          : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta charset="utf-8">
    <meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <% if current_page.data.key?('meta') %>
      <% current_page.data.meta.each do |meta| %>
        <meta
          <% meta.each do |key, value| %>
            <%= "#{key}=\"#{value}\"" %>
          <% end %>
        >
      <% end %>
    <% end %>
    <title><%= current_page.data.title || "API Documentation" %></title>

    <style media="screen">
      <%= Rouge::Themes::MonokaiSublimeSlate.render(:scope => '.highlight') %>
    </style>
    <style media="print">
      * {
        transition:none!important;
      }
      <%= Rouge::Themes::Base16::Solarized.render(:scope => '.highlight') %>
    </style>
    <%= stylesheet_link_tag :screen, media: :screen %>
    <%= stylesheet_link_tag :print, media: :print %>
    <% if current_page.data.search %>
      <%= javascript_include_tag  "all" %>
    <% else %>
      <%= javascript_include_tag  "all_nosearch" %>
    <% end %>

    <% if current_page.data.code_clipboard %>
    <script>
      $(function() { setupCodeCopy(); });
    </script>
    <% end %>
  </head>

  <body class="<%= page_classes %>" data-languages="<%=h language_tabs.map{ |lang| lang.is_a?(Hash) ? lang.keys.first : lang }.to_json %>">
    <header class="docs-topbar">
      <a href="#introduccion" class="docs-topbar-brand">
        <%= image_tag "logo.png", class: 'docs-topbar-logo', alt: 'Apunto' %>
      </a>
      <nav class="docs-topbar-nav">
        <a href="https://apunto.io" target="_blank" rel="noopener">Plataforma</a>
        <a href="#introduccion" class="active">API Docs</a>
      </nav>
      <div class="docs-topbar-actions">
        <% if current_page.data.search %>
          <div class="search topbar-search">
            <input type="text" class="search" id="input-search" placeholder="Buscar" autocomplete="off">
            <button type="button" id="search-clear" class="search-clear" aria-label="Limpiar búsqueda">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.71L12 12.01l-6.3-6.3-1.41 1.41 6.3 6.3-6.3 6.3 1.41 1.41 6.3-6.3 6.3 6.3 1.41-1.41-6.3-6.3 6.3-6.3z"/></svg>
            </button>
            <kbd class="topbar-search-kbd">/</kbd>
            <ul class="search-results"></ul>
          </div>
        <% end %>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Cambiar entre tema claro y oscuro" title="Tema claro / oscuro">
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 18a6 6 0 1 1 0-12 6 6 0 0 1 0 12zm0-2a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM11 1h2v3h-2V1zm0 19h2v3h-2v-3zM3.515 4.929l1.414-1.414L7.05 5.636 5.636 7.05 3.515 4.93zM16.95 18.364l1.414-1.414 2.121 2.121-1.414 1.414-2.121-2.121zm2.121-14.85l1.414 1.415-2.121 2.121-1.414-1.414 2.121-2.121zM5.636 16.95l1.414 1.414-2.121 2.121-1.414-1.414 2.121-2.121zM23 11v2h-3v-2h3zM4 11v2H1v-2h3z"/></svg>
        </button>
        <a href="#" id="nav-button" class="docs-topbar-menu-btn" aria-label="Abrir navegación">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"/></svg>
        </a>
      </div>
    </header>
    <div class="toc-wrapper">
      <div class="docs-sidebar-meta">API Reference · v1</div>
      <% if language_tabs.any? %>
        <div class="lang-selector docs-lang-grid">
          <% language_tabs.each do |lang| %>
            <% key = lang.is_a?(Hash) ? lang.keys.first : lang %>
            <% label = lang.is_a?(Hash) ? lang.values.first : lang %>
            <a href="#" class="lang-chip" data-language-name="<%= key %>">
              <span class="lang-chip-icon"><%= key[0,2].upcase %></span>
              <span class="lang-chip-label"><%= label %></span>
            </a>
          <% end %>
        </div>
      <% end %>
      <ul id="toc" class="toc-list-h1">
        <% toc_data(page_content).each do |h1| %>
          <li>
            <a href="#<%= h1[:id] %>" class="toc-h1 toc-link<%= ' has-children' if h1[:children].length > 0 %>" data-title="<%= h1[:title] %>"><%= h1[:content] %></a>
            <% if h1[:children].length > 0 %>
              <ul class="toc-list-h2">
                <% h1[:children].each do |h2| %>
                  <li>
                    <a href="#<%= h2[:id] %>" class="toc-h2 toc-link" data-title="<%= h2[:title] %>"><%= h2[:content] %></a>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if current_page.data.toc_footers %>
        <ul class="toc-footer">
          <% current_page.data.toc_footers.each do |footer| %>
            <li><%= footer %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <div class="page-wrapper">
      <div class="dark-box"></div>
      <div class="content">
        <%= page_content %>
      </div>
      <div class="dark-box">
        <% if language_tabs.any? %>
          <div class="lang-selector docs-lang-grid">
            <div class="docs-lang-grid-label">Lenguaje</div>
            <% language_tabs.each do |lang| %>
              <% key = lang.is_a?(Hash) ? lang.keys.first : lang %>
              <% label = lang.is_a?(Hash) ? lang.values.first : lang %>
              <a href="#" class="lang-chip" data-language-name="<%= key %>">
                <span class="lang-chip-icon"><%= key[0,2].upcase %></span>
                <span class="lang-chip-label"><%= label %></span>
              </a>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </body>
</html>
